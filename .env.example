# PostgreSQL
POSTGRES_DB=logbook
POSTGRES_USER=logbook
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_MAX=10

# Shared backend/frontend API credential. Use at least 16 characters.
API_KEY=replace-with-a-long-random-api-key
API_BIND_ADDRESS=192.168.68.62
API_PORT=8787
FRONTEND_BIND_ADDRESS=192.168.68.62
FRONTEND_PORT=8790
CORS_ORIGINS=
LOG_LEVEL=info
DB_VOLUME_NAME=logbook-backend_logbook-db-pg18

# Shared analysis runtime limits. Invalid values fail backend startup.
ANALYSIS_EXECUTION_TIMEOUT_MS=5000
ANALYSIS_MEMORY_LIMIT_BYTES=67108864
ANALYSIS_STACK_LIMIT_BYTES=1048576
ANALYSIS_MAX_INPUT_EVENTS=25000
ANALYSIS_MAX_OUTPUT_POINTS=25000
ANALYSIS_MAX_OUTPUT_SERIES=12
ANALYSIS_MAX_CONSOLE_ENTRIES=100
ANALYSIS_MAX_SERIALIZED_RESULT_BYTES=5242880
ANALYSIS_WORKER_POOL_SIZE=2
